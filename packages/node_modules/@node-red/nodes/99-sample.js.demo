// If you use this as a template, update the copyright with your own name.
// 如果你使用这个作为模板，请更新版权信息为你自己的名字。

// Sample Node-RED node file
// Node-RED 节点示例文件


module.exports = function(RED) {
    "use strict";
    // require any external libraries we may need....
    // 引入我们可能需要的任何外部库....
    //var foo = require("foo-library");

    // The main node definition - most things happen in here
    // 主要的节点定义 - 大多数功能都在这里实现
    function SampleNode(n) {
        // Create a RED node
        // 创建一个 RED 节点
        RED.nodes.createNode(this,n);

        // Store local copies of the node configuration (as defined in the .html)
        // 存储节点配置的本地副本（在.html中定义）
        this.topic = n.topic;

        // copy "this" object in case we need it in context of callbacks of other functions.
        // 复制"this"对象，以防我们在其他函数的回调上下文中需要它
        var node = this;

        // Do whatever you need to do in here - declare callbacks etc
        // Note: this sample doesn't do anything much - it will only send
        // this message once at startup...
        // Look at other real nodes for some better ideas of what to do....
        // 在这里执行你需要做的任何事情 - 声明回调等
        // 注意：这个示例并没有做太多事情 - 它只会在启动时发送一次消息...
        // 查看其他真实的节点以获取更好的实现思路....
        var msg = {};
        msg.topic = this.topic;
        msg.payload = "Hello world !"

        // send out the message to the rest of the workspace.
        // ... this message will get sent at startup so you may not see it in a debug node.
        // 将消息发送到工作区的其他部分
        // ... 这个消息会在启动时发送，所以你可能在调试节点中看不到它
        this.send(msg);

        // respond to inputs....
        // 响应输入....
        this.on('input', function (msg) {
            node.warn("I saw a payload: "+msg.payload);
            // in this example just send it straight on... should process it here really
            // 在这个例子中只是直接转发... 实际上应该在这里处理它
            node.send(msg);
        });

        this.on("close", function() {
            // Called when the node is shutdown - eg on redeploy.
            // Allows ports to be closed, connections dropped etc.
            // eg: node.client.disconnect();
            // 当节点关闭时调用 - 例如在重新部署时
            // 允许关闭端口、断开连接等
            // 例如：node.client.disconnect();
        });
    }

    // Register the node by name. This must be called before overriding any of the
    // Node functions.
    // 通过名称注册节点。这必须在重写任何节点函数之前调用。
    RED.nodes.registerType("sample",SampleNode);

}
